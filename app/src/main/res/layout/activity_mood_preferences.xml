<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:forceDarkAllowed="false" tools:targetApi="q">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/primary" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="44dp" android:paddingBottom="14dp"
        android:forceDarkAllowed="false" tools:targetApi="q">
        <TextView android:id="@+id/iv_back" android:layout_width="36dp" android:layout_height="36dp"
            android:gravity="center" android:text="←" android:textColor="@color/white" android:textSize="22sp"
            android:background="@android:color/transparent"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Trip Preferences" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold"
            android:background="@android:color/transparent"/>
        <View android:layout_width="36dp" android:layout_height="36dp"
            android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="What is the primary goal of your Nashik trip?"
                android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_pilgrimage" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_pilgrimage" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_pilgrimage" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pilgrimage" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_wine_tour" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_wine" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_wine" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wine Tour" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_adventure" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_adventure" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_adventure" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adventure" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_heritage" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_heritage" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_heritage" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heritage" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_nature" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_nature" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_nature" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nature" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_family" xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="5dp"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" android:layout_columnWeight="1" app:strokeWidth="2dp" app:strokeColor="@color/border">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/iv_mood_family" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_family" android:layout_marginBottom="6dp" app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Family" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Preferred travel pace?" android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="12dp"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_pace_relaxed" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" android:layout_marginBottom="10dp" app:strokeWidth="2dp" app:strokeColor="@color/border">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😌" android:textSize="24sp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relaxed" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2–3 spots/day" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_pace_moderate" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" android:layout_marginBottom="10dp" app:strokeWidth="2dp" app:strokeColor="@color/border">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚶" android:textSize="24sp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moderate" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4–5 spots/day" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_pace_packed" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" android:layout_marginBottom="20dp" app:strokeWidth="2dp" app:strokeColor="@color/border">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="24sp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packed" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6+ spots/day" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tv_select_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="Please select a trip goal to continue"
                android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginBottom="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="80dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_generate_itinerary"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="✨ Generate AI Itinerary" style="@style/NashikButton"/>
    </LinearLayout>
</LinearLayout>