<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_route_from_to" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nashik → Trimbakeshwar" android:textColor="@color/text_primary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ " android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_route_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="45 min" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginEnd="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📏 " android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_route_distance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="28 km" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/tv_traffic_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Moderate" android:textColor="@color/accent" android:textSize="11sp"
                android:textStyle="bold" android:background="@drawable/bg_blue_light_rounded"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_route_via" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Via: Trimbak Road" android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginBottom="2dp"/>
        <LinearLayout android:id="@+id/layout_route_details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tv_route_fare" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💰 Fare: ₹350" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_route_mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🚗 Mode: Road" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_select_route"
                android:layout_width="match_parent" android:layout_height="42dp"
                android:text="🗺️ Open in Google Maps" style="@style/NashikButton" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>