<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/primary" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="44dp" android:paddingBottom="14dp"
        xmlns:tools="http://schemas.android.com/tools" tools:targetApi="q" android:forceDarkAllowed="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp"
            android:background="@android:color/transparent">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Hotels" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold"
                android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/btn_notif_hotels" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_bell" android:padding="4dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_rounded_white" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp">
            <EditText android:id="@+id/et_hotel_search" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@null" android:hint="Search hotels in Nashik..."
                android:textColor="@color/text_primary" android:textSize="14sp" android:textColorHint="@color/text_hint"/>
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:scrollbars="none" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
            <TextView android:id="@+id/chip_sort_rating" android:layout_width="wrap_content" android:layout_height="36dp"
                android:background="@drawable/bg_chip_active" android:gravity="center"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:text="⭐ Rating"
                android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/chip_sort_price" android:layout_width="wrap_content" android:layout_height="36dp"
                android:background="@drawable/bg_chip_outline" android:gravity="center"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:text="💰 Price"
                android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/chip_sort_discount" android:layout_width="wrap_content" android:layout_height="36dp"
                android:background="@drawable/bg_chip_outline" android:gravity="center"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:text="🏷️ Discount"
                android:textColor="@color/text_hint" android:textSize="12sp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_hotels"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipToPadding="false"/>
</LinearLayout>