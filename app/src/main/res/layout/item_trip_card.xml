<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp" app:cardCornerRadius="20dp"
    app:cardElevation="2dp" app:strokeWidth="0dp"
    tools:targetApi="q" android:forceDarkAllowed="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        xmlns:tools="http://schemas.android.com/tools" tools:targetApi="q" android:forceDarkAllowed="false">
        <!-- Colored Header Section -->
        <RelativeLayout android:id="@+id/trip_card_bg" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="16dp" android:background="@color/primary">
            <ImageView android:id="@+id/iv_trip_emoji" android:layout_width="54dp" android:layout_height="54dp"
                android:padding="8dp" android:src="@drawable/ic_home"
                android:layout_marginEnd="12dp" app:tint="@color/white"
                android:layout_alignParentStart="true" android:layout_centerVertical="true"
                android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_toEndOf="@id/iv_trip_emoji"
                android:layout_toStartOf="@+id/tv_nights_badge" android:layout_centerVertical="true"
                android:background="@android:color/transparent">
                <TextView android:id="@+id/tv_trip_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nashik Pilgrimage Tour" android:textColor="@color/white"
                    android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="2dp"
                    android:background="@android:color/transparent"/>
                <TextView android:id="@+id/tv_trip_dates" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📅 23 Oct – 26 Oct 2024" android:textColor="#E0FFFFFF" android:textSize="11sp"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_nights_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_blue_light_rounded" android:backgroundTint="#40FFFFFF"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="4dp" android:paddingBottom="4dp" android:text="3 nights"
                android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold"
                android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
        </RelativeLayout>
        <!-- White Bottom Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@color/white">
            <TextView android:id="@+id/tv_trip_tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pilgrimage" android:textColor="@color/accent"
                android:background="@drawable/bg_chip_outline" android:textSize="11sp"
                android:textStyle="bold" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="6dp" android:paddingBottom="6dp"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_view_trip"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:text="View →" style="@style/NashikButtonOutline" android:textSize="12sp"
                app:cornerRadius="10dp" android:paddingStart="16dp" android:paddingEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
