<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    app:cardCornerRadius="13dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <TextView android:id="@+id/tv_attr_emoji" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_blue_light_rounded" android:gravity="center"
            android:text="🙏" android:textSize="20sp" android:layout_marginEnd="12dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_attr_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attraction Name" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/tv_attr_timing" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="5:30 AM – 9:00 PM" android:textColor="@color/text_hint" android:textSize="10sp" android:layout_marginBottom="4dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_attr_rating" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="★ 4.9" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tv_attr_fee" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Free" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tv_attr_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⏱️ 2 hrs" android:textColor="@color/text_hint" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>