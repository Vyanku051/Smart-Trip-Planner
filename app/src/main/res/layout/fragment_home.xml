<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <!-- Professional Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_primary_header" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="44dp" android:paddingBottom="24dp"
        xmlns:tools="http://schemas.android.com/tools" tools:targetApi="q" android:forceDarkAllowed="false">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:background="@android:color/transparent">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_alignParentStart="true"
                android:background="@android:color/transparent">
                <TextView android:id="@+id/tv_greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Good Morning 🌿" android:textColor="#DDFFFFFF" android:textSize="12sp"
                    android:background="@android:color/transparent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Smart Trip Planner" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_alignParentEnd="true" android:gravity="center_vertical"
                android:background="@android:color/transparent">
                <FrameLayout android:id="@+id/btn_notifications" android:layout_width="38dp" android:layout_height="38dp"
                    android:background="@drawable/bg_transparent_white" android:layout_marginEnd="10dp" android:padding="8dp"
                    tools:targetApi="q" android:forceDarkAllowed="false">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/ic_bell" app:tint="@color/accent" android:background="@android:color/transparent"
                        android:forceDarkAllowed="false"/>
                    <View android:id="@+id/notif_badge" android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_gravity="top|end" android:background="@drawable/bg_red_badge" android:visibility="gone"/>
                </FrameLayout>
                <TextView android:id="@+id/tv_avatar" android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_accent_badge" android:gravity="center"
                    android:text="AK" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"
                    tools:targetApi="q" android:forceDarkAllowed="false"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Welcome Card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_blue_light_rounded" android:orientation="horizontal"
            android:gravity="center_vertical" android:padding="16dp" android:backgroundTint="#2A6ABF"
            tools:targetApi="q" android:forceDarkAllowed="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:background="@android:color/transparent" android:forceDarkAllowed="false">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Good Morning," android:textColor="#DDFFFFFF" android:textSize="11sp"
                    android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                <TextView android:id="@+id/tv_hello_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hello, Ajay!" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"
                    android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Let's plan your Nashik adventure 🗺️" android:textColor="#EEFFFFFF" android:textSize="12sp" android:layout_marginTop="2dp"
                    android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
            </LinearLayout>
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_home" app:tint="@color/white"
                android:alpha="0.8" android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/quick_actions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
                android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginBottom="24dp">

                <!-- Action 1: New Trip -->
                <LinearLayout android:id="@+id/btn_new_trip" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_blue_light_rounded" android:padding="18dp" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_add" app:tint="@color/primary"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/new_trip" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Action 2: AI Chat -->
                <LinearLayout android:id="@+id/btn_ai_chat" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_blue_light_rounded" android:padding="18dp" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_chat" app:tint="#8E44AD"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ai_chat" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Action 3: Map -->
                <LinearLayout android:id="@+id/btn_map_quick" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_blue_light_rounded" android:padding="18dp" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_map" app:tint="#27AE60"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/map" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Action 4: Routes -->
                <LinearLayout android:id="@+id/btn_routes_quick" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_blue_light_rounded" android:padding="18dp" android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_car" app:tint="@color/red"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/routes" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/upcoming_trips" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btn_view_map_all" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/see_all" android:textColor="@color/primary" android:textSize="12sp" android:padding="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_trips"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:nestedScrollingEnabled="false" android:layout_marginBottom="20dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/top_attractions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btn_view_attractions_map" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/view_map" android:textColor="@color/primary" android:textSize="12sp" android:padding="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_attractions"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:clipToPadding="false"
                android:layout_marginBottom="24dp"/>

            <!-- Trending Weather Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" app:strokeWidth="0dp"
                xmlns:tools="http://schemas.android.com/tools" tools:targetApi="q" android:forceDarkAllowed="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/primary" android:orientation="vertical" android:padding="16dp"
                    android:forceDarkAllowed="false">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" android:background="@android:color/transparent"
                        android:forceDarkAllowed="false">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nashik Today" android:textColor="#BDFFFFFF" android:textSize="12sp"
                            android:layout_alignParentStart="true" android:background="@android:color/transparent"
                            android:forceDarkAllowed="false"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nashik, MH" android:textColor="@color/accent" android:textSize="12sp"
                            android:textStyle="bold" android:layout_alignParentEnd="true" android:background="@android:color/transparent"
                            android:forceDarkAllowed="false"/>
                    </RelativeLayout>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@android:color/transparent" android:forceDarkAllowed="false">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="bottom" android:layout_alignParentStart="true"
                            android:background="@android:color/transparent" android:forceDarkAllowed="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="28" android:textColor="@color/white" android:textSize="48sp" android:textStyle="bold"
                                android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="°C" android:textColor="#BDFFFFFF" android:textSize="20sp" android:layout_marginBottom="8dp"
                                android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="☀️" android:textSize="54sp" android:layout_centerInParent="true" android:layout_marginStart="20dp"
                            android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_alignParentEnd="true" android:gravity="end"
                            android:background="@android:color/transparent" android:forceDarkAllowed="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="💧 62% humidity" android:textColor="#BDFFFFFF" android:textSize="11sp"
                                android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🌬️ 14 km/h wind" android:textColor="#BDFFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"
                                android:background="@android:color/transparent" android:forceDarkAllowed="false"/>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
