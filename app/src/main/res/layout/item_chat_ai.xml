<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="start" android:paddingBottom="10dp">
    <TextView android:layout_width="30dp" android:layout_height="30dp"
        android:background="@drawable/bg_blue_light_rounded" android:gravity="center"
        android:text="🤖" android:textSize="14sp" android:layout_marginEnd="8dp" android:layout_marginTop="2dp"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginEnd="60dp">
        <TextView android:id="@+id/tv_chat_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai" android:textColor="@color/text_primary" android:textSize="14sp"
            android:lineSpacingMultiplier="1.4" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="10dp" android:paddingBottom="10dp" android:elevation="1dp"/>
        <TextView android:id="@+id/tv_chat_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10:00 AM" android:textColor="@color/text_hint" android:textSize="10sp" android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>