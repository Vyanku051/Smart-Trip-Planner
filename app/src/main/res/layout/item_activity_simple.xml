<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/white" android:padding="12dp" android:layout_marginBottom="4dp">
    <TextView android:id="@+id/tv_act_emoji" android:layout_width="34dp" android:layout_height="34dp"
        android:background="@drawable/bg_blue_light_rounded" android:gravity="center"
        android:text="🙏" android:textSize="16sp" android:layout_marginEnd="10dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_act_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="9:00 AM" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
        <TextView android:id="@+id/tv_act_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Activity Name" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_act_location" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📍 Location" android:textColor="@color/text_hint" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textColor="@color/border" android:textSize="16sp"/>
</LinearLayout>